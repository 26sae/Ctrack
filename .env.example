# Copy this file to .env and replace the placeholders with your own values.
MYSQLHOST=your-aiven-host.aivencloud.com
MYSQLPORT=your-aiven-port
MYSQLDATABASE=your-database-name
MYSQLUSER=your-username
MYSQLPASSWORD=your-password
MYSQL_SSL_CA_PATH=./ca.pem

# Set only when the API is behind a known, fixed number of trusted proxies.
# TRUST_PROXY_HOPS=1

# Optional frontend settings
VITE_API_BASE_URL=
VITE_GOOGLE_MAPS_API_KEY=
